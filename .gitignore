# ============================================================
# DonutPay monorepo .gitignore
# Flutter (LTDD_Finance) + Spring Boot (core-backend) + FastAPI (ai-service)
# ============================================================

# ---------- SECRETS / KEYS (never push) ----------
*.env
.env
.env.*
*.pem
*.p12
*.jks
*.keystore
*.key
key.properties
keystore.properties
secrets.properties
**/keys/
serviceAccount*.json
**/google-services.json
**/GoogleService-Info.plist
**/AI_Rules.md
# Spring config with credentials — ignore ALL variants incl. example/template
**/application.yml
**/application.yaml
**/application-*.yml
**/application-*.yaml
**/application.example.yml
**/application.example.yaml
**/application*.properties
!**/application*.properties.template

# General credentials & tokens
**/credentials*.json
**/*credentials*.json
**/client_secret*.json
**/serviceAccountKey.json
**/firebase-adminsdk*.json
*.credentials
.credentials/
.gitcredentials
credentials.json
credentials.yml
credentials.yaml
secrets.yml
secrets.yaml
jwt_*.key
jwt_*.pem
jwt_*.pub
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub
authorized_keys
known_hosts

