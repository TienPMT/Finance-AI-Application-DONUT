# ============================================================
# DonutPay monorepo .gitignore
# Flutter (LTDD_Finance) + Spring Boot (core-backend) + FastAPI (ai-service)
# ============================================================

# ---------- SECRETS / KEYS (never push) ----------
*.env
.env
.env.*
*.pem
*.p12
*.jks
*.keystore
*.key
key.properties
keystore.properties
secrets.properties
**/keys/
serviceAccount*.json
**/google-services.json
**/GoogleService-Info.plist
**/AI_Rules.md
# Spring config with credentials — ignore ALL variants incl. example/template
**/application.yml
**/application.yaml
**/application-*.yml
**/application-*.yaml
**/application.example.yml
**/application.example.yaml
**/application*.properties
!**/application*.properties.template

# DB dumps / backups / personal data
backups/
**/backups/
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.csv
# ---------- Uploads / Media ----------
**/uploads/
**/media/
**/tmp/
# logs (may leak tokens/paths)
*.log
**/logs/

# ---------- Flutter / Dart ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/
*.lock.bak
# generated platform glue (keep pubspec.lock tracked on purpose)
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
**/ServiceDefinitions.json
android/local.properties
**/android/local.properties
**/.gradle/

# ---------- Java / Spring (Maven) ----------
target/
**/target/
*.class
*.jar
*.war
!**/.mvn/wrapper/maven-wrapper.jar
hs_err_pid*

# ---------- Python / FastAPI ----------
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
**/.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- IDE / Editor ----------
.idea/
**/.idea/
*.iml
.vscode/
**/.vscode/
*.swp
*.swo

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- ML weights (>100MB, GitHub rejects — share via Drive/HF) ----------
*.safetensors
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.pb
*.tflite
*.bin
*.gguf
**/donut_result/*.safetensors
