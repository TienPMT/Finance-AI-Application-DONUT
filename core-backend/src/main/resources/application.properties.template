# Server Configuration
server.port=8081

# Database Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/finance_db
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate Config
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.open-in-view=false

# PostgreSQL Binaries Path for Backup Service (adjust according to your system)
# Windows example: D:\\Software\\PostgreSQL\\bin
# Linux example: /usr/bin
postgres.bin.path=your_postgresql_bin_path

# Cloudinary Storage Configuration (Replace with actual keys if needed)
cloudinary.cloud-name=your_cloudinary_cloud_name
cloudinary.api-key=your_cloudinary_api_key
cloudinary.api-secret=your_cloudinary_api_secret

# Payment Configurations (Mocks and Webhooks)
payment.secret=your_mock_payment_secret_key
payment.zalopay.secret=your_zalopay_secret_key
payment.vnpay.secret=your_vnpay_secret_key
payment.mock-gateway-url=http://localhost:8081/mock-gateway
payment.webhook-url=http://localhost:8081/api/payment/webhook

# Google OAuth Config
app.google.web-client-id=your_google_web_client_id

# Email Configurations (SMTP Gmail)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your_email@gmail.com
spring.mail.password=your_email_app_password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
